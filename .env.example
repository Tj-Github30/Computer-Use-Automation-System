# LLM provider: gemini | openai | auto. Used for discovery only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# true = local mock planner (no API key needed). false = live LLM discovery.
# Ignored by replay, which never calls a model.
USE_MOCK_LLM=true
HEADLESS=false

# Guardrails. The agent may not act outside these.
ALLOWED_DOMAINS=localhost,127.0.0.1
ALLOWED_PATH_PREFIXES=/
# How to treat actions that cannot be undone: confirm | block | allow
IRREVERSIBLE_ACTION_POLICY=confirm

# How long a run waits for a human operator during a handoff.
ESCALATION_TIMEOUT_MS=120000
ESCALATION_POLL_MS=1000
