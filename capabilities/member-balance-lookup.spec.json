{
  "name": "member-balance-lookup",
  "description": "Look up a member in the core servicing terminal and return their current savings balance.",
  "appId": "coreunion-member-servicing",
  "appVersion": "4.2",
  "tenantId": "base",
  "inputs": {
    "memberId": {
      "type": "string",
      "required": true,
      "description": "Member identifier as keyed by the operator.",
      "example": "12345",
      "pattern": "^[0-9]{1,10}$",
      "sensitive": false
    }
  },
  "outputs": {
    "savingsBalance": {
      "type": "string",
      "description": "Current savings balance as displayed on the member record.",
      "sensitive": true
    }
  },
  "successCheckpoint": {
    "type": "text_present",
    "value": "Result Code:",
    "timeoutMs": 10000
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "kind": "business",
      "description": "No member exists for the supplied identifier.",
      "detect": { "type": "text_present", "value": "MEMBER_NOT_FOUND" },
      "escalate": false
    },
    {
      "code": "VALIDATION_ERROR",
      "kind": "business",
      "description": "The application rejected the supplied member identifier.",
      "detect": { "type": "text_present", "value": "Validation error:" },
      "escalate": false
    },
    {
      "code": "PERMISSION_DENIED",
      "kind": "hard",
      "description": "The operating role is not permitted to view this member record.",
      "detect": { "type": "text_present", "value": "Permission denied" },
      "escalate": true
    },
    {
      "code": "SESSION_EXPIRED",
      "kind": "hard",
      "description": "The terminal session ended and automation cannot re-authenticate.",
      "detect": { "type": "text_present", "value": "Session expired" },
      "escalate": true
    },
    {
      "code": "APP_ERROR",
      "kind": "hard",
      "description": "The core system returned an internal error.",
      "detect": { "type": "text_present", "value": "Unexpected application error" },
      "escalate": true
    },
    {
      "code": "UNEXPECTED_DIALOG",
      "kind": "recoverable",
      "description": "A review-flag dialog appeared over the record and was dismissed.",
      "detect": { "type": "dialog_opened", "value": "" },
      "recovery": { "action": "dismiss_dialog", "maxAttempts": 2, "waitMs": 250 },
      "escalate": false
    },
    {
      "code": "TRANSIENT_LOAD_FAILURE",
      "kind": "recoverable",
      "description": "The record pane was still loading when the step ran.",
      "detect": { "type": "action_error", "value": "Timeout" },
      "recovery": { "action": "wait_and_retry", "maxAttempts": 3, "waitMs": 1500 },
      "escalate": false
    }
  ]
}
